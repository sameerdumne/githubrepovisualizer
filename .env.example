# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=

# GitHub Token (Optional, increases rate limits)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=

# GitHub OAuth App
# Callback URL for local development: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Used to sign login session cookies. Generate a long random string for production.
AUTH_SECRET=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
